# ==========================================================
# Home Physio India - Environment Template
# Copy to .env and fill in real values.
# ==========================================================

# ---- Application ----
APP_NAME="Home Physio India"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---- Security / JWT ----
SECRET_KEY=replace_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Database (MongoDB Atlas) ----
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=home_physio_india

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Home Physio India"
SMTP_TLS=true
SMTP_SSL=false
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- ZegoCloud (24x7 Video Call) ----
ZEGO_APP_ID=149684840
ZEGO_SERVER_SECRET=a1ba3a9d4ff4b8316a7e97249742c9e4
ZEGO_APP_SIGN=f2a557e8e1f2448f3c016a85c1e5fca9ce353a81df9d65ec0a8dc8965d055807

# ---- First / bootstrap admin ----
FIRST_ADMIN_NAME="Super Admin"
FIRST_ADMIN_EMAIL=admin@homephysioindia.com
FIRST_ADMIN_PASSWORD=Admin@1234Secure!
